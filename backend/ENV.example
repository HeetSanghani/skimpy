# RBAC Authentication - Required for Render
# Copy to .env and fill in values

# JWT (REQUIRED)
JWT_SECRET_KEY=your-secret-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Account lockout (brute-force protection)
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Rate limiting (auth endpoints per IP per minute)
RATE_LIMIT_AUTH_PER_MINUTE=10

# Admin credentials (REQUIRED for admin login)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=secure-admin-password

# Environment (production disables docs, strict CORS)
ENVIRONMENT=production

# CORS - Vercel frontend domain
FRONTEND_URL=https://skimpy.vercel.app

# Stripe (for payment webhook verification)
STRIPE_WEBHOOK_SECRET=whsec_...
